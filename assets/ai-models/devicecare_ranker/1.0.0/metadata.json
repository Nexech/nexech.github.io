{
  "artifact_release": "1.0",
  "model_name": "nexech_devicecare_ranker",
  "title": "Device Care - Recommendation order",
  "description": "Orders Device Care's recommendation cards inside one severity group for this device and this person: it reads the card (kind, severity, action, age), how the person reacted to that kind of card before, the device now (form factor, time of day, battery and charging, heat, free storage, memory, internet) and the shape of the list, and returns a relevance in [0, 1] for each card. It runs on the device only, never adds, removes or re-rates a card, never changes an action or the device status, and sees no package, file, network name, measured value or identifier.",
  "intended_use": "Optional ordering of Device Care recommendations on the device; the deterministic order is always the fallback.",
  "limitations": [
    "Labels come from a documented expert policy over synthetic scenarios, not from recorded user behaviour.",
    "It ranks inside one severity group only and cannot move a card across severities or change what is shown.",
    "Physical-device latency and battery measurements are separate release gates."
  ],
  "copyright": "Copyright (c) 2026 Nexech. All rights reserved.",
